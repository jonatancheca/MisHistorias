{
  "name": "MisHistorias",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.2.0",
  "scripts": {
    "build": "nuxt build",
    "postbuild": "node scripts/copy-start-server.mjs",
    "local-deploy": "pnpm build && node scripts/deploy-output.mjs",
    "dev": "nuxt dev --host localhost",
    "dev2": "nuxt dev --host 0.0.0.0 --port 3010 --envName dev2",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node .output/start-server.mjs",
    "serve": "pnpm build && pnpm start",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "node --test --test-isolation=none",
    "test:e2e": "playwright test",
    "test:storage": "pnpm test:unit",
    "test:updater": "pwsh -NoProfile -File scripts/update.test.ps1",
    "postinstall": "nuxt prepare"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.1",
    "cropperjs": "2.1.1",
    "jszip": "^3.10.1",
    "nuxt": "^4.5.1",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dom-chromium-ai": "^0.0.17",
    "eslint": "^10.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vue-tsc": "^3.3.9"
  }
}
